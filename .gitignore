# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
**/node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/artifacts/

# local AI-agent notes and one-off migration helpers
/docs/
/add_imports.cjs
/final_imports.cjs
/update_exports.cjs

# editor and local runtime state
/.cursor/
**/isolated-profile/
**/user-data/
**/Code Cache/
**/GPUCache/
**/DawnGraphiteCache/
**/DawnWebGPUCache/
**/Local Storage/
**/Session Storage/
**/Shared Dictionary/

# local databases and encrypted vault material
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite-shm
*.sqlite-wal
*.sqlite3
*.sqlite3-shm
*.sqlite3-wal
**/keystore/secrets.v1.json
**/secrets.v1.json

# next.js
**/.next/
**/out/

# production
**/build
**/dist
**/release
# Local Electron packaging and smoke-test output. These folders can contain
# unpacked applications hundreds of megabytes in size and are never source.
apps/desktop/release-qa/
apps/desktop/release-qa-*/

# misc
.DS_Store
*.pem
*.key
*.p12
*.pfx

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!**/.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
