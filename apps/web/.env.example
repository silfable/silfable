# Required: MongoDB Atlas connection URL used by Prisma.
DATABASE_URL="mongodb+srv://username:password@cluster.mongodb.net/silfable?retryWrites=true&w=majority"

# Required for production links, canonical metadata, and social previews.
NEXT_PUBLIC_SITE_URL="https://your-project.vercel.app"

# Cloud worker/encrypted authority state only. Generate one random 32-byte
# value and keep it stable across deployments. The current Vercel web routes
# do not require it unless encrypted worker state is enabled.
WORKER_ENCRYPTION_KEY="replace-with-a-random-64-character-hex-secret"

# Recommended: private production RPC endpoints.
SOLANA_RPC_URL="https://your-private-solana-mainnet-rpc"
NEXT_PUBLIC_SOLANA_RPC_URL="https://your-browser-safe-solana-mainnet-rpc"
ROBINHOOD_RPC_URL="https://rpc.mainnet.chain.robinhood.com"

# Required only for managed Pump.fun image and metadata publication.
# Use a least-privilege Pinata JWT. Never prefix this variable with NEXT_PUBLIC_.
SILFABLE_PINATA_JWT="replace-with-your-pinata-jwt"
SILFABLE_PINATA_GATEWAY="https://gateway.pinata.cloud/ipfs"

# Optional: Relay API authentication for Robinhood/Solana bridge routes.
RELAY_API_KEY="replace-with-your-relay-api-key"

# Cloud worker only. The current Vercel web runtime does not import BullMQ,
# but the separate 24/7 worker requires this value.
REDIS_URL="rediss://default:password@your-redis-host:port"
