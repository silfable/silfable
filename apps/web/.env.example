# MongoDB Cloud Atlas Connection URL
DATABASE_URL="mongodb+srv://username:password@cluster.mongodb.net/silfable?retryWrites=true&w=majority"

# Redis Cloud Connection URL for BullMQ 24/7 Cloud Worker
REDIS_URL="redis://default:password@redis-cloud-instance.redislabs.com:12345"

# AES-256 Secret Key for Ephemeral Vault Encryption (32-byte hex string)
ENCRYPTION_SECRET_KEY="replace-with-a-random-64-character-hex-secret"

# Optional Solana RPC for server-side quote preparation and broadcast.
# Leave unset to use https://api.mainnet-beta.solana.com.
# SOLANA_RPC_URL="https://mainnet.helius-rpc.com/?api-key=..."

# Server-only Pinata public IPFS storage for Token Launch images and metadata.
# Create a least-privilege JWT with file upload permission. Never prefix it with NEXT_PUBLIC_.
SILFABLE_PINATA_JWT="replace-with-your-pinata-jwt"
SILFABLE_PINATA_GATEWAY="https://gateway.pinata.cloud/ipfs"
